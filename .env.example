# Reference only: the Worker does not load this file automatically.
# Set these values privately through your hosting provider's server-only runtime settings.
# Replace example addresses with the accounts authorized for YOUR deployment.
AUTHORIZED_ACCOUNTS='[{"email":"owner@example.invalid","role":"owner"},{"email":"member@example.invalid","role":"member"}]'
# Optional comma-separated exact HTTPS origins, only after verifying the receiver.
# https://chatgpt.com is already allowed by the application.
MCP_CALLBACK_ORIGINS=
# DB is a D1 binding, not a string environment variable.
# DOTCORD_TOKEN belongs only in the sender's private environment. Do not put a token here.

# Optional Google/Gmail sign-in: create a Google Cloud OAuth Web application client.
# Configure its consent audience and authorize the exact deployed HTTPS callback.
# Runtime settings only; never commit real credentials here.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://YOUR-SITE-HOST/auth/google/callback
# Requests openid email only. Gmail data access is not required.
# Host access policy and AUTHORIZED_ACCOUNTS still apply.
