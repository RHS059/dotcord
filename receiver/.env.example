# Private server runtime configuration; this file is not automatically loaded.
# Receiver-app subject, observed through its own /api/identity after host sign-in.
RECEIVER_SUBJECT=
DOTCORD_ORIGIN=https://dotcord.example.invalid
# Scoped receiver credential issued by the intended account in shared Dotcord.
DOTCORD_RECEIVER_TOKEN=
# Optional supported Sites service-access bearer for the exact shared origin.
# This passes its hosting gate; it grants no Dotcord account identity.
DOTCORD_SITES_TOKEN=
